# =============================================================================
# aurelia Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — NEVER expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# AI Provider ('gemini' | 'openai' — default: 'gemini')
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini

# Google Gemini (Recommended development provider — free tier via Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# Dedicated Recipe Extraction Model (recommended: gemini-3.5-flash-lite for separate quota pool & high throughput)
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite

# OpenAI (Alternative / future production provider)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (Secondary / cross-provider fallback for recipe extraction)
# Server-only — NEVER expose this to the browser or mobile app
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_EXTRACTION_MODEL=openai/gpt-4o-mini

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

